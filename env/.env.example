DATABASE_URL=postgresql+psycopg://event:event@postgres:5432/events
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
WORKER_CONCURRENCY=4
POLL_INTERVAL_SECONDS=0.5
HTTP_TIMEOUT_SECONDS=10
CLAIM_LEASE_SECONDS=60
LEASE_HEARTBEAT_SECONDS=15
RETRY_BACKOFF_BASE_SECONDS=2
RETRY_BACKOFF_MAX_SECONDS=3600
FAILURE_THRESHOLD=5
QUARANTINE_SECONDS=900
# 单份副本连续传输失败到这个次数，进死信处，不再自动重打
MAX_DELIVERY_ATTEMPTS=10
MAX_RESPONSE_BODY_BYTES=2048
RECEIPT_TIMEOUT_SECONDS=300
# 超时/失败回执的副本重投多少轮后仍对不上，进死信处
MAX_REQUEUE_CYCLES=3
RECONCILE_SWEEP_INTERVAL_SECONDS=5
RECEIPT_DELIVERY_GRACE_SECONDS=2
INGEST_MAX_AGE_SECONDS=300
INGEST_MAX_FUTURE_SKEW_SECONDS=60
CONFIRM_TIMEOUT_SECONDS=300
CONFIRM_BACKOFF_BASE_SECONDS=2
CONFIRM_BACKOFF_MAX_SECONDS=60
CONFIRM_POLL_INTERVAL_SECONDS=1
CONFIRMATION_ENABLED=true
# “先给预告、地址点头才给正文”的类型：开启策略时未显式给点头时限的兜底秒数
PREVIEW_CONSENT_TIMEOUT_SECONDS_DEFAULT=86400
